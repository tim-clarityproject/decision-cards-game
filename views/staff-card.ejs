<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= card.title %> - Decision Cards Game</title>
    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background: #FAFAFA;
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
            background: white;
            border-radius: 4px;
            padding: 40px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            border: 1px solid #E8E8E8;
        }

        .breadcrumb {
            color: #666;
            font-size: 0.95em;
            margin-bottom: 20px;
        }

        .breadcrumb a {
            color: #1A1A1A;
            text-decoration: none;
            font-weight: 600;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        h1 {
            color: #1A1A1A;
            font-size: 2em;
            margin-bottom: 30px;
            line-height: 1.4;
            font-weight: 700;
        }

        .card-content {
            background: #f9f9f9;
            border-left: 4px solid #2C5F7F;
            padding: 20px;
            border-radius: 4px;
            margin-bottom: 30px;
            color: #666;
            line-height: 1.6;
            font-size: 1.05em;
        }

        .card-content strong {
            color: #1A1A1A;
        }

        .actions {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 30px;
        }

        .action-btn {
            display: block;
            padding: 15px 20px;
            text-align: center;
            text-decoration: none;
            border-radius: 0;
            font-weight: 600;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            transition: background 0.3s, transform 0s;
            border: none;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.95em;
        }

        .select-btn {
            background: #F0F0F0;
            color: #1A1A1A;
        }

        .select-btn:hover {
            background: #E0E0E0;
            transform: none;
            box-shadow: none;
        }

        .select-btn.selected {
            background: #1A1A1A;
            color: white;
        }

        .select-btn.selected:hover {
            background: #333;
            transform: none;
            box-shadow: none;
        }

        .view-results {
            background: #1A1A1A;
            color: white;
        }

        .view-results:hover {
            background: #333;
            transform: none;
            box-shadow: none;
        }

        .locked {
            background: #ddd;
            color: #999;
            cursor: not-allowed;
        }

        .locked:hover {
            transform: none;
            box-shadow: none;
        }

        .lock-icon {
            margin-right: 8px;
        }

        .navigation {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #E8E8E8;
        }

        .nav-btn {
            padding: 12px;
            background: #f0f0f0;
            color: #1A1A1A;
            text-decoration: none;
            border-radius: 0;
            text-align: center;
            font-weight: 600;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            transition: background 0.3s;
            text-transform: uppercase;
            font-size: 0.85em;
            letter-spacing: 0.3px;
        }

        .nav-btn:hover {
            background: #e0e0e0;
        }

        .home-link {
            grid-column: 1 / -1;
            background: #1A1A1A;
            color: white;
        }

        .home-link:hover {
            background: #333;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            background: #ffeaa7;
            color: #333;
            border-radius: 20px;
            font-size: 0.85em;
            margin-top: 15px;
        }

        @media (max-width: 768px) {
            body {
                padding: 30px 15px;
            }

            .container {
                max-width: 100%;
                padding: 30px 20px;
                border-radius: 4px;
            }

            .breadcrumb {
                font-size: 0.85em;
                margin-bottom: 15px;
            }

            h1 {
                font-size: 1.6em;
                margin-bottom: 20px;
                line-height: 1.3;
            }

            .card-content {
                padding: 15px;
                margin-bottom: 20px;
                font-size: 0.95em;
            }

            .action-btn {
                padding: 12px 16px;
                font-size: 0.95em;
            }

            .navigation {
                gap: 10px;
                margin-top: 20px;
                padding-top: 20px;
            }

            .nav-btn {
                padding: 10px;
                font-size: 0.9em;
                border-radius: 4px;
            }

            .status-badge {
                padding: 5px 10px;
                font-size: 0.8em;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 12px 10px;
            }

            .container {
                padding: 20px 15px;
                border-radius: 8px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            }

            .breadcrumb {
                font-size: 0.8em;
                margin-bottom: 12px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            h1 {
                font-size: 1.3em;
                margin-bottom: 15px;
                line-height: 1.3;
            }

            .card-content {
                padding: 12px;
                margin-bottom: 15px;
                font-size: 0.9em;
                line-height: 1.5;
                border-radius: 3px;
            }

            .actions {
                gap: 12px;
                margin-bottom: 20px;
            }

            .action-btn {
                padding: 14px 12px;
                font-size: 0.9em;
                border-radius: 4px;
                min-height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

            .lock-icon {
                margin-right: 4px;
                font-size: 1.1em;
            }

            #selectIcon {
                font-size: 1.1em;
            }

            .navigation {
                display: flex;
                flex-direction: column;
                gap: 10px;
                margin-top: 15px;
                padding-top: 15px;
            }

            .nav-btn {
                padding: 12px;
                font-size: 0.9em;
                border-radius: 4px;
                width: 100%;
                min-height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .home-link {
                grid-column: auto;
                margin-top: 5px;
            }

            .status-badge {
                padding: 5px 8px;
                font-size: 0.75em;
                margin-top: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="breadcrumb">
            <a href="/">Home</a> <% if (roundNumber) { %> / <a href="/round/<%= roundNumber %>">Round <%= roundNumber %></a> / <a href="/round/<%= roundNumber %>/team-actions">Team Actions for Round <%= roundNumber %></a><% } else { %> / <a href="/staff-cards">Team Actions for Round 1</a><% } %> / Card <%= card.id %>
        </div>

        <h1><%= card.title %></h1>

        <div class="card-content">
            <% if (card.scenario) { %>
                <p><%= card.scenario %></p>
            <% } else { %>
                <p><strong>SCENARIO DETAILS — [INSERT YOUR SCENARIO HERE]</strong></p>
                <p>This is placeholder text. Replace with your actual scenario context, situation description, and the key decision or challenge that participants need to respond to.</p>
            <% } %>
        </div>

        <div class="actions">
            <button id="selectBtn" class="action-btn select-btn" onclick="toggleSelection()">
                <span id="selectIcon">☐</span> <span id="selectText">Mark as Selected</span>
            </button>
            <% if (roundNumber) { %>
                <a href="/round/<%= roundNumber %>/team-actions/<%= card.id %>/results" class="action-btn view-results">
                    <span class="lock-icon">🔓</span>View Results
                </a>
            <% } else { %>
                <a href="/staff-cards/<%= card.id %>/results" class="action-btn view-results">
                    <span class="lock-icon">🔓</span>View Results
                </a>
            <% } %>
        </div>

        <script>
            const cardKey = 'card_<%= roundNumber || 1 %>_team_<%= card.id %>';

            function toggleSelection() {
                const selected = localStorage.getItem(cardKey);
                if (selected) {
                    localStorage.removeItem(cardKey);
                    updateButton(false);
                } else {
                    localStorage.setItem(cardKey, 'true');
                    updateButton(true);
                }
            }

            function updateButton(isSelected) {
                const btn = document.getElementById('selectBtn');
                const icon = document.getElementById('selectIcon');
                const text = document.getElementById('selectText');
                if (isSelected) {
                    btn.classList.add('selected');
                    icon.textContent = '☑';
                    text.textContent = 'Selected';
                } else {
                    btn.classList.remove('selected');
                    icon.textContent = '☐';
                    text.textContent = 'Mark as Selected';
                }
            }

            window.addEventListener('load', () => {
                const isSelected = localStorage.getItem(cardKey);
                updateButton(!!isSelected);
            });
        </script>

        <div class="navigation">
            <% if (prevId) { %>
                <% if (roundNumber) { %>
                    <a href="/round/<%= roundNumber %>/team-actions/<%= prevId %>" class="nav-btn">← Card <%= prevId %></a>
                <% } else { %>
                    <a href="/staff-cards/<%= prevId %>" class="nav-btn">← Card <%= prevId %></a>
                <% } %>
            <% } else { %>
                <div style="grid-column: 1;"></div>
            <% } %>
            <% if (nextId) { %>
                <% if (roundNumber) { %>
                    <a href="/round/<%= roundNumber %>/team-actions/<%= nextId %>" class="nav-btn">Card <%= nextId %> →</a>
                <% } else { %>
                    <a href="/staff-cards/<%= nextId %>" class="nav-btn">Card <%= nextId %> →</a>
                <% } %>
            <% } else { %>
                <div style="grid-column: 2;"></div>
            <% } %>
            <% if (roundNumber) { %>
                <a href="/round/<%= roundNumber %>/team-actions" class="nav-btn">Back to Team Actions</a>
                <a href="/round/<%= roundNumber %>/stakeholder-actions" class="nav-btn">Go to Stakeholder Actions</a>
                <a href="/round/<%= roundNumber %>" class="nav-btn home-link">← All Actions</a>
            <% } else { %>
                <a href="/staff-cards" class="nav-btn">Back to Team Actions</a>
                <a href="/stakeholder-cards" class="nav-btn">Go to Stakeholder Actions</a>
                <a href="/" class="nav-btn home-link">← Home</a>
            <% } %>
        </div>
    </div>
</body>
</html>
