<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Cards - Decision Cards Game</title>
    <style>
        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstRegularDesktop.otf') format('opentype');
            font-weight: 400;
        }

        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstLightDesktop.otf') format('opentype');
            font-weight: 300;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nekst', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #3C3C3B;
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .header {
            background: white;
            border-radius: 12px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .header h1 {
            color: #3C3C3B;
            margin-bottom: 20px;
            font-size: 2em;
            font-weight: 400;
        }

        .nav-btn {
            display: inline-block;
            padding: 12px 30px;
            background: #FF6F5C;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            margin: 0 10px;
            font-family: 'Nekst', sans-serif;
            transition: background 0.2s;
        }

        .nav-btn:hover {
            background: #E85A4A;
        }

        .home-btn {
            background: #999;
        }

        .home-btn:hover {
            background: #777;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        }

        .card-number {
            display: inline-block;
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #FF6F5C 0%, #5FEF8B 100%);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.5em;
            margin-bottom: 15px;
        }

        .card-title {
            color: #3C3C3B;
            font-size: 1.1em;
            font-weight: 400;
            margin-bottom: 15px;
            line-height: 1.4;
        }

        .card-link {
            display: block;
            padding: 10px;
            background: #f5f5f5;
            color: #FF6F5C;
            text-decoration: none;
            border-radius: 4px;
            text-align: center;
            font-weight: 400;
            font-family: 'Nekst', sans-serif;
            transition: background 0.2s;
        }

        .card-link:hover {
            background: #FF6F5C;
            color: white;
        }

        .footer {
            background: white;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .footer a {
            color: #FF6F5C;
            text-decoration: none;
            margin: 0 10px;
        }

        .footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📋 Decision Cards for Reports</h1>
            <div style="margin-top: 20px;">
                <a href="/" class="nav-btn home-btn">← Home</a>
                <a href="/stakeholder-cards" class="nav-btn">Go to Stakeholder Cards →</a>
            </div>
        </div>

        <div class="cards-grid">
            <% cards.forEach(card => { %>
                <a href="/staff-cards/<%= card.id %>" style="text-decoration: none;">
                    <div class="card">
                        <div class="card-number"><%= card.id %></div>
                        <div class="card-title"><%= card.title %></div>
                        <div class="card-link">View Card →</div>
                    </div>
                </a>
            <% }); %>
        </div>

        <div class="footer">
            <a href="/">← Home</a>
            <a href="/stakeholder-cards">Stakeholder Cards →</a>
        </div>
    </div>
</body>
</html>
