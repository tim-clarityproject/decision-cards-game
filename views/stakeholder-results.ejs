<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Card <%= card.id %> Results - Decision Cards Game</title>
    <style>
        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstRegularDesktop.otf') format('opentype');
            font-weight: 400;
        }

        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstLightDesktop.otf') format('opentype');
            font-weight: 300;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nekst', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #FAFAFA;
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 4px;
            padding: 40px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            border: 1px solid #E8E8E8;
        }

        .breadcrumb {
            color: #666;
            font-size: 0.95em;
            margin-bottom: 20px;
        }

        .breadcrumb a {
            color: #2C5F7F;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        h1 {
            color: #1A1A1A;
            font-size: 2em;
            margin-bottom: 10px;
            line-height: 1.4;
            font-weight: 400;
        }

        .subtitle {
            color: #666;
            font-size: 0.95em;
            margin-bottom: 30px;
        }

        .results-section {
            background: #f9f9f9;
            border-left: 4px solid #2C5F7F;
            padding: 20px;
            border-radius: 4px;
            margin-bottom: 25px;
            color: #666;
            line-height: 1.6;
            font-size: 1.05em;
        }

        .section-title {
            color: #1A1A1A;
            font-size: 1.3em;
            font-weight: 400;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-icon {
            font-size: 1.4em;
        }

        .results-section strong {
            color: #1A1A1A;
        }

        .navigation {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #E8E8E8;
        }

        .nav-btn {
            padding: 12px;
            background: #f0f0f0;
            color: #2C5F7F;
            text-decoration: none;
            border-radius: 4px;
            text-align: center;
            font-weight: 400;
            font-family: 'Nekst', sans-serif;
            transition: background 0.2s;
            min-height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-btn:hover {
            background: #e0e0e0;
        }

        .home-link {
            grid-column: 1 / -1;
            background: #5C9D8F;
            color: white;
        }

        .home-link:hover {
            background: #457B6B;
        }

        .reflection-box {
            background: #f9f9f9;
            border-left: 4px solid #2C5F7F;
            padding: 20px;
            border-radius: 4px;
            margin-top: 20px;
            font-style: italic;
            color: #555;
        }

        @media (max-width: 768px) {
            body {
                padding: 30px 15px;
            }

            .container {
                max-width: 100%;
                padding: 30px 20px;
                border-radius: 4px;
            }

            .breadcrumb {
                font-size: 0.85em;
                margin-bottom: 15px;
            }

            h1 {
                font-size: 1.5em;
                margin-bottom: 8px;
                line-height: 1.3;
            }

            .subtitle {
                font-size: 0.9em;
                margin-bottom: 20px;
            }

            .results-section {
                padding: 15px;
                margin-bottom: 20px;
                font-size: 0.95em;
            }

            .section-title {
                font-size: 1.1em;
                margin-bottom: 12px;
            }

            .section-icon {
                font-size: 1.2em;
            }

            .reflection-box {
                padding: 15px;
                margin-top: 15px;
            }

            .navigation {
                gap: 10px;
                margin-top: 20px;
                padding-top: 20px;
            }

            .nav-btn {
                padding: 10px;
                font-size: 0.9em;
                border-radius: 4px;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 12px 8px;
            }

            .container {
                padding: 16px 12px;
                border-radius: 4px;
                box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            }

            .breadcrumb {
                font-size: 0.7em;
                margin-bottom: 10px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            h1 {
                font-size: 1.2em;
                margin-bottom: 4px;
                line-height: 1.3;
            }

            .subtitle {
                font-size: 0.85em;
                margin-bottom: 15px;
            }

            .results-section {
                padding: 12px;
                margin-bottom: 15px;
                font-size: 0.9em;
                line-height: 1.5;
                border-radius: 4px;
            }

            .section-title {
                font-size: 1em;
                margin-bottom: 10px;
            }

            .section-icon {
                font-size: 1.1em;
            }

            .results-section p {
                margin-bottom: 10px;
            }

            .reflection-box {
                padding: 12px;
                margin-top: 12px;
                border-radius: 4px;
                font-size: 0.9em;
            }

            .navigation {
                display: flex;
                flex-direction: column;
                gap: 8px;
                margin-top: 15px;
                padding-top: 15px;
            }

            .nav-btn {
                padding: 10px;
                font-size: 0.85em;
                border-radius: 4px;
                width: 100%;
            }

            .home-link {
                grid-column: auto;
                margin-top: 5px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="breadcrumb">
            <a href="/">Home</a> <% if (roundNumber) { %> / <a href="/round/<%= roundNumber %>">Round <%= roundNumber %></a> / <a href="/round/<%= roundNumber %>/stakeholder-actions">Stakeholder Actions for Round <%= roundNumber %></a> / <a href="/round/<%= roundNumber %>/stakeholder-actions/<%= card.id %>">Card <%= card.id %></a><% } else { %> / <a href="/stakeholder-cards">Stakeholder Actions for Round 1</a> / <a href="/stakeholder-cards/<%= card.id %>">Card <%= card.id %></a><% } %> / Results
        </div>

        <h1><%= card.title %> — Results</h1>

        <div class="results-section">
            <div class="section-title">
                <span class="section-icon">📊</span>
                <span>What Happened?</span>
            </div>
            <% if (card.results) { %>
                <%
                    // Extract score changes from results text
                    const scoreRegex = /([\w\s,]+?)\s+get\s+(?:an\s+)?(?:extra\s+)?(?:additional\s+)?(Trust|Alignment|Autonomy|TRUST|ALIGNMENT|AUTONOMY)\s+([\+\-]\d+)/g;
                    const matches = [...card.results.matchAll(scoreRegex)];
                    let narrative = card.results;
                    matches.forEach(match => {
                        narrative = narrative.replace(match[0], '');
                    });
                    // Clean up narrative: remove ellipses, extra spaces, and line breaks
                    narrative = narrative.replace(/\.{2,}/g, '.').replace(/\s+/g, ' ').replace(/\n+/g, ' ').trim();

                    // Normalize attribute names to Title Case
                    const attrNames = {
                        'TRUST': 'Trust',
                        'ALIGNMENT': 'Alignment',
                        'AUTONOMY': 'Autonomy',
                        'Trust': 'Trust',
                        'Alignment': 'Alignment',
                        'Autonomy': 'Autonomy'
                    };

                    const colors = {
                        'TRUST': '#F39C12',
                        'ALIGNMENT': '#3498DB',
                        'AUTONOMY': '#2ECC71',
                        'Trust': '#F39C12',
                        'Alignment': '#3498DB',
                        'Autonomy': '#2ECC71'
                    };
                %>
                <p style="line-height: 1.8; margin-bottom: 25px;"><%= narrative %></p>

                <% if (matches.length > 0) { %>
                    <div style="margin-top: 25px;">
                        <h3 style="font-size: 1.1em; margin-bottom: 15px; color: #1A1A1A;">Score Changes:</h3>
                        <div style="display: grid; gap: 12px;">
                            <% matches.forEach(match => {
                                let actor = match[1].trim();
                                const attr = match[2];
                                const change = match[3];
                                const isPositive = change.startsWith('+');

                                // Clean up actor text - remove leading punctuation and extra spaces
                                actor = actor.replace(/^[,\s]+/, '').replace(/\s+/g, ' ').trim();
                            %>
                                <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px; background: #f5f5f5; border-radius: 4px; flex-wrap: wrap;">
                                    <span style="min-width: auto; flex: 1; font-size: 0.9em; color: #333;"><strong><%= actor %></strong></span>
                                    <span style="flex: 1; display: flex; gap: 8px; align-items: center;">
                                        <span style="background: <%= colors[attr] %>; color: white; padding: 4px 10px; border-radius: 3px; font-size: 0.9em; font-weight: 600;"><%= attrNames[attr] %></span>
                                        <span style="font-size: 1.1em; font-weight: 700; color: <%= isPositive ? '#27AE60' : '#E74C3C' %>;"><%= change %></span>
                                    </span>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <p><strong>[INSERT RESULTS SUMMARY]</strong></p>
                <p>This section describes what occurred based on the decisions made by the participant. Replace this placeholder with a detailed explanation of the outcomes and consequences of the choices presented in the scenario.</p>
            <% } %>
        </div>

        <div class="navigation">
            <% if (prevId) { %>
                <% if (roundNumber) { %>
                    <a href="/round/<%= roundNumber %>/stakeholder-actions/<%= prevId %>/results" class="nav-btn">← Previous Card</a>
                <% } else { %>
                    <a href="/stakeholder-cards/<%= prevId %>/results" class="nav-btn">← Previous Card</a>
                <% } %>
            <% } else { %>
                <div style="grid-column: 1;"></div>
            <% } %>
            <% if (nextId) { %>
                <% if (roundNumber) { %>
                    <a href="/round/<%= roundNumber %>/stakeholder-actions/<%= nextId %>/results" class="nav-btn">Next Card →</a>
                <% } else { %>
                    <a href="/stakeholder-cards/<%= nextId %>/results" class="nav-btn">Next Card →</a>
                <% } %>
            <% } else { %>
                <div style="grid-column: 2;"></div>
            <% } %>
            <% if (roundNumber) { %>
                <a href="/round/<%= roundNumber %>/stakeholder-actions" class="nav-btn">Back to Stakeholder Actions</a>
                <a href="/round/<%= roundNumber %>/team-actions" class="nav-btn">Go to Team Actions</a>
                <a href="/round/<%= roundNumber %>" class="nav-btn home-link">← All Actions</a>
            <% } else { %>
                <a href="/stakeholder-cards" class="nav-btn">Back to Stakeholder Actions</a>
                <a href="/staff-cards" class="nav-btn">Go to Team Actions</a>
                <a href="/" class="nav-btn home-link">← Home</a>
            <% } %>
        </div>
    </div>
</body>
</html>
