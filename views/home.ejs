<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leadership Simulation Decision Cards</title>
    <style>
        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstRegularDesktop.otf') format('opentype');
            font-weight: 400;
        }

        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstLightDesktop.otf') format('opentype');
            font-weight: 300;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nekst', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #FAFAFA;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 60px;
        }

        h1 {
            color: #1A1A1A;
            margin-bottom: 12px;
            font-size: 3.5em;
            font-weight: 400;
            line-height: 1.1;
            letter-spacing: -1px;
        }

        .subtitle {
            color: #666;
            font-size: 1.2em;
            font-weight: 300;
            margin-bottom: 20px;
        }

        .container {
            max-width: 700px;
            width: 100%;
        }

        .card-links {
            display: flex;
            gap: 24px;
            flex-direction: column;
            margin-bottom: 50px;
        }

        .card-link {
            display: block;
            padding: 32px;
            background: white;
            color: #1A1A1A;
            text-decoration: none;
            border-radius: 4px;
            font-size: 1.3em;
            font-weight: 400;
            transition: all 0.2s;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            border: 1px solid #E8E8E8;
        }

        .card-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

        .auth-section {
            padding-top: 40px;
            border-top: 1px solid #E8E8E8;
            margin-top: 40px;
            text-align: center;
        }

        .auth-btn {
            padding: 14px 40px;
            background: #2C5F7F;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
            font-family: 'Nekst', sans-serif;
            font-weight: 400;
        }

        .auth-btn:hover {
            background: #1F4560;
            transform: translateY(-2px);
        }

        .logout-btn {
            background: #5C9D8F;
        }

        .logout-btn:hover {
            background: #457B6B;
        }

        .status {
            margin-bottom: 20px;
            font-size: 0.95em;
            color: #666;
        }

        @media (max-width: 768px) {
            body {
                padding: 30px 20px;
            }

            .header {
                margin-bottom: 40px;
            }

            h1 {
                font-size: 2.5em;
                margin-bottom: 10px;
            }

            .subtitle {
                font-size: 1.1em;
            }

            .card-links {
                gap: 18px;
                margin-bottom: 40px;
            }

            .card-link {
                padding: 24px;
                font-size: 1.1em;
            }

            .auth-btn {
                padding: 12px 32px;
                font-size: 0.95em;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 20px;
            }

            .header {
                margin-bottom: 30px;
            }

            h1 {
                font-size: 1.8em;
                margin-bottom: 8px;
            }

            .subtitle {
                font-size: 0.95em;
            }

            .card-links {
                gap: 12px;
                margin-bottom: 30px;
            }

            .card-link {
                padding: 20px;
                font-size: 1em;
            }

            .auth-section {
                padding-top: 30px;
                margin-top: 30px;
            }

            .auth-btn {
                padding: 12px 28px;
                font-size: 0.9em;
            }

            .status {
                font-size: 0.9em;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Leadership Simulation</h1>
        <p class="subtitle">Decision Cards — Round 1</p>
    </div>

    <div class="container">
        <div class="card-links">
            <a href="/staff-cards" class="card-link">📋 Decision Cards for Reports</a>
            <a href="/stakeholder-cards" class="card-link">👥 Decision Cards for Stakeholders</a>
        </div>

        <div class="auth-section">
            <% if (authenticated) { %>
                <p class="status">✅ You have access to results</p>
                <a href="/logout" class="auth-btn logout-btn">Sign Out</a>
            <% } else { %>
                <p class="status">🔒 Results are password protected</p>
                <a href="/login" class="auth-btn">Sign In for Results</a>
            <% } %>
        </div>
    </div>
</body>
</html>
