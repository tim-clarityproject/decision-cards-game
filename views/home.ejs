<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leadership Simulation Decision Cards</title>
    <style>
        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstRegularDesktop.otf') format('opentype');
            font-weight: 400;
        }

        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstLightDesktop.otf') format('opentype');
            font-weight: 300;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nekst', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #FAFAFA;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 60px;
        }

        h1 {
            color: #1A1A1A;
            margin-bottom: 12px;
            font-size: 3.5em;
            font-weight: 400;
            line-height: 1.1;
            letter-spacing: -1px;
        }

        .subtitle {
            color: #666;
            font-size: 1.2em;
            font-weight: 300;
            margin-bottom: 20px;
        }

        .container {
            max-width: 700px;
            width: 100%;
        }

        .card-links {
            display: flex;
            gap: 24px;
            flex-direction: column;
            margin-bottom: 50px;
        }

        .card-link {
            display: block;
            padding: 32px;
            background: white;
            color: #1A1A1A;
            text-decoration: none;
            border-radius: 4px;
            font-size: 1.3em;
            font-weight: 400;
            transition: all 0.2s;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            border: 1px solid #E8E8E8;
        }

        .card-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

        .auth-section {
            padding-top: 40px;
            border-top: 1px solid #E8E8E8;
            margin-top: 40px;
            text-align: center;
        }

        .auth-btn {
            padding: 14px 40px;
            background: #2C5F7F;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
            font-family: 'Nekst', sans-serif;
            font-weight: 400;
        }

        .auth-btn:hover {
            background: #1F4560;
            transform: translateY(-2px);
        }

        .logout-btn {
            background: #5C9D8F;
        }

        .logout-btn:hover {
            background: #457B6B;
        }

        .status {
            margin-bottom: 20px;
            font-size: 0.95em;
            color: #666;
        }

        .auth-section {
            padding-top: 40px;
            border-top: 1px solid #E8E8E8;
            margin-top: 40px;
        }

        .auth-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 24px;
        }

        .round-auth {
            background: white;
            padding: 24px;
            border-radius: 4px;
            border: 1px solid #E8E8E8;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .round-auth h3 {
            color: #1A1A1A;
            font-size: 1.1em;
            margin-bottom: 16px;
            font-weight: 400;
        }

        .round-auth.authenticated {
            background: #F0F8F5;
            border-color: #5C9D8F;
        }

        .round-auth.authenticated h3::after {
            content: " ✓";
            color: #5C9D8F;
        }

        .password-input {
            width: 100%;
            padding: 12px;
            border: 1px solid #D8D8D8;
            border-radius: 4px;
            font-size: 1em;
            font-family: 'Nekst', sans-serif;
            margin-bottom: 12px;
            background: #FAFAFA;
            transition: all 0.2s;
        }

        .password-input:focus {
            outline: none;
            border-color: #2C5F7F;
            background: white;
            box-shadow: 0 0 0 3px rgba(44, 95, 127, 0.1);
        }

        .submit-btn {
            width: 100%;
            padding: 12px;
            background: #2C5F7F;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 1em;
            cursor: pointer;
            font-family: 'Nekst', sans-serif;
            font-weight: 400;
            transition: all 0.2s;
        }

        .submit-btn:hover {
            background: #1F4560;
            transform: translateY(-2px);
        }

        .logout-section {
            text-align: center;
            margin-top: 30px;
        }

        .logout-btn {
            padding: 14px 40px;
            background: #5C9D8F;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
            font-family: 'Nekst', sans-serif;
            font-weight: 400;
        }

        .logout-btn:hover {
            background: #457B6B;
            transform: translateY(-2px);
        }

        @media (max-width: 768px) {
            body {
                padding: 30px 20px;
            }

            .header {
                margin-bottom: 40px;
            }

            h1 {
                font-size: 2.5em;
                margin-bottom: 10px;
            }

            .subtitle {
                font-size: 1.1em;
            }

            .card-links {
                gap: 18px;
                margin-bottom: 40px;
            }

            .card-link {
                padding: 24px;
                font-size: 1.1em;
            }

            .auth-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 20px;
            }

            .header {
                margin-bottom: 30px;
            }

            h1 {
                font-size: 1.8em;
                margin-bottom: 8px;
            }

            .subtitle {
                font-size: 0.95em;
            }

            .card-links {
                gap: 12px;
                margin-bottom: 30px;
            }

            .card-link {
                padding: 20px;
                font-size: 1em;
            }

            .auth-section {
                padding-top: 30px;
                margin-top: 30px;
            }

            .auth-grid {
                grid-template-columns: 1fr;
            }

            .status {
                font-size: 0.9em;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Leadership Simulation</h1>
    </div>

    <div class="container">
        <div class="card-links">
            <a href="/round/1" class="card-link">🎯 Round 1</a>
            <a href="/round/2" class="card-link">🎯 Round 2</a>
            <a href="/round/3" class="card-link">🎯 Round 3</a>
        </div>

        <div class="auth-section">
            <% if (error) { %>
                <div style="background: #FDE8E8; border: 1px solid #F0C4C4; color: #C44545; padding: 14px; border-radius: 4px; margin-bottom: 24px; font-size: 0.95em;">
                    <%= error %>
                </div>
            <% } %>
            <h2 style="text-align: center; color: #1A1A1A; font-size: 1.4em; margin-bottom: 24px; font-weight: 400;">Unlock Results</h2>

            <div class="auth-grid">
                <div class="round-auth <% if (authenticatedRounds && authenticatedRounds.includes(1)) { %>authenticated<% } %>">
                    <h3>Round 1</h3>
                    <% if (authenticatedRounds && authenticatedRounds.includes(1)) { %>
                        <p style="color: #5C9D8F; font-size: 0.95em;">Unlocked</p>
                    <% } else { %>
                        <form method="POST" action="/login">
                            <input type="hidden" name="round" value="1">
                            <input type="password" class="password-input" name="password" placeholder="Enter password" required>
                            <button type="submit" class="submit-btn">Unlock</button>
                        </form>
                    <% } %>
                </div>

                <div class="round-auth <% if (authenticatedRounds && authenticatedRounds.includes(2)) { %>authenticated<% } %>">
                    <h3>Round 2</h3>
                    <% if (authenticatedRounds && authenticatedRounds.includes(2)) { %>
                        <p style="color: #5C9D8F; font-size: 0.95em;">Unlocked</p>
                    <% } else { %>
                        <form method="POST" action="/login">
                            <input type="hidden" name="round" value="2">
                            <input type="password" class="password-input" name="password" placeholder="Enter password" required>
                            <button type="submit" class="submit-btn">Unlock</button>
                        </form>
                    <% } %>
                </div>

                <div class="round-auth <% if (authenticatedRounds && authenticatedRounds.includes(3)) { %>authenticated<% } %>">
                    <h3>Round 3</h3>
                    <% if (authenticatedRounds && authenticatedRounds.includes(3)) { %>
                        <p style="color: #5C9D8F; font-size: 0.95em;">Unlocked</p>
                    <% } else { %>
                        <form method="POST" action="/login">
                            <input type="hidden" name="round" value="3">
                            <input type="password" class="password-input" name="password" placeholder="Enter password" required>
                            <button type="submit" class="submit-btn">Unlock</button>
                        </form>
                    <% } %>
                </div>
            </div>

            <% if (authenticated) { %>
                <div class="logout-section">
                    <a href="/logout" class="logout-btn">Sign Out of All Rounds</a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
