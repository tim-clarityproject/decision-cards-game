<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leadership Simulation Decision Cards</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background: #FAFAFA;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 60px 20px 40px;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        h1 {
            color: #1A1A1A;
            margin-bottom: 12px;
            font-size: 3.5em;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.5px;
        }

        .subtitle {
            color: #666;
            font-size: 1.2em;
            font-weight: 400;
            margin-bottom: 20px;
        }

        .container {
            max-width: 700px;
            width: 100%;
        }

        .card-links {
            display: flex;
            gap: 24px;
            flex-direction: column;
            margin-bottom: 50px;
        }

        .card-link {
            display: block;
            padding: 24px 32px;
            background: #1A1A1A;
            color: white;
            text-decoration: none;
            border-radius: 0;
            font-size: 1.1em;
            font-weight: 600;
            transition: all 0.3s;
            box-shadow: none;
            border: none;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-link:hover {
            transform: none;
            background: #333;
        }

        .auth-section {
            padding-top: 40px;
            border-top: 1px solid #E8E8E8;
            margin-top: 40px;
            text-align: center;
        }

        .auth-btn {
            padding: 14px 40px;
            background: #1A1A1A;
            color: white;
            border: none;
            border-radius: 0;
            font-size: 0.95em;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .auth-btn:hover {
            background: #333;
            transform: none;
        }

        .logout-btn {
            background: #5C9D8F;
        }

        .logout-btn:hover {
            background: #457B6B;
        }

        .status {
            margin-bottom: 20px;
            font-size: 0.95em;
            color: #666;
        }

        .auth-section {
            padding-top: 40px;
            border-top: 1px solid #E8E8E8;
            margin-top: 40px;
        }

        .auth-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 24px;
        }

        .round-auth {
            background: white;
            padding: 24px;
            border-radius: 4px;
            border: 1px solid #E8E8E8;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .round-auth h3 {
            color: #1A1A1A;
            font-size: 1.1em;
            margin-bottom: 16px;
            font-weight: 400;
        }

        .round-auth.authenticated {
            background: #F0F8F5;
            border-color: #5C9D8F;
        }

        .round-auth.authenticated h3::after {
            content: " ✓";
            color: #5C9D8F;
        }

        .password-input {
            width: 100%;
            padding: 12px;
            border: 1px solid #D8D8D8;
            border-radius: 4px;
            font-size: 1em;
            font-family: 'Nekst', sans-serif;
            margin-bottom: 12px;
            background: #FAFAFA;
            transition: all 0.2s;
        }

        .password-input:focus {
            outline: none;
            border-color: #2C5F7F;
            background: white;
            box-shadow: 0 0 0 3px rgba(44, 95, 127, 0.1);
        }

        .submit-btn {
            width: 100%;
            padding: 14px;
            background: #1A1A1A;
            color: white;
            border: none;
            border-radius: 0;
            font-size: 0.95em;
            cursor: pointer;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-weight: 600;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .submit-btn:hover {
            background: #333;
            transform: none;
        }

        .logout-section {
            text-align: center;
            margin-top: 30px;
        }

        .logout-btn {
            padding: 14px 40px;
            background: #1A1A1A;
            color: white;
            border: none;
            border-radius: 0;
            font-size: 0.95em;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .logout-btn:hover {
            background: #333;
            transform: none;
        }

        @media (max-width: 768px) {
            body {
                padding: 30px 20px;
            }

            .header {
                margin-bottom: 40px;
            }

            h1 {
                font-size: 2.5em;
                margin-bottom: 10px;
            }

            .subtitle {
                font-size: 1.1em;
            }

            .card-links {
                gap: 18px;
                margin-bottom: 40px;
            }

            .card-link {
                padding: 24px;
                font-size: 1.1em;
            }

            .auth-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 20px;
            }

            .header {
                margin-bottom: 30px;
            }

            h1 {
                font-size: 1.8em;
                margin-bottom: 8px;
            }

            .subtitle {
                font-size: 0.95em;
            }

            .card-links {
                gap: 12px;
                margin-bottom: 30px;
            }

            .card-link {
                padding: 20px;
                font-size: 1em;
            }

            .auth-section {
                padding-top: 30px;
                margin-top: 30px;
            }

            .auth-grid {
                grid-template-columns: 1fr;
            }

            .status {
                font-size: 0.9em;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Leadership Simulation</h1>
    </div>

    <div class="container">
        <div class="card-links">
            <a href="/round/1" class="card-link">Round 1</a>
            <a href="/round/2" class="card-link">Round 2</a>
            <a href="/round/3" class="card-link">Round 3</a>
        </div>

    </div>
</body>
</html>
