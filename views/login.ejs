<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In - Decision Cards</title>
    <style>
        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstRegularDesktop.otf') format('opentype');
            font-weight: 400;
        }

        @font-face {
            font-family: 'Nekst';
            src: url('/fonts/NekstLightDesktop.otf') format('opentype');
            font-weight: 300;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nekst', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #FAFAFA;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .container {
            background: white;
            border-radius: 4px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            max-width: 480px;
            width: 100%;
            padding: 50px 40px;
            text-align: center;
            border: 1px solid #E8E8E8;
        }

        h1 {
            color: #1A1A1A;
            margin-bottom: 30px;
            font-size: 2.2em;
            font-weight: 400;
            line-height: 1.2;
        }

        .form-group {
            margin-bottom: 24px;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 10px;
            color: #1A1A1A;
            font-weight: 400;
            font-size: 0.95em;
        }

        input[type="password"] {
            width: 100%;
            padding: 14px;
            border: 1px solid #D8D8D8;
            border-radius: 4px;
            font-size: 1em;
            font-family: 'Nekst', sans-serif;
            transition: all 0.2s;
            background: #FAFAFA;
        }

        input[type="password"]:focus {
            outline: none;
            border-color: #2C5F7F;
            background: white;
            box-shadow: 0 0 0 3px rgba(44, 95, 127, 0.1);
        }

        .error {
            color: #C44545;
            background: #FDE8E8;
            padding: 14px;
            border-radius: 4px;
            margin-bottom: 24px;
            font-size: 0.95em;
            border: 1px solid #F0C4C4;
        }

        button {
            width: 100%;
            padding: 14px;
            background: #2C5F7F;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 1em;
            font-weight: 400;
            cursor: pointer;
            font-family: 'Nekst', sans-serif;
            transition: all 0.2s;
        }

        button:hover {
            background: #1F4560;
            transform: translateY(-2px);
        }

        .back-link {
            margin-top: 28px;
            text-align: center;
        }

        .back-link a {
            color: #2C5F7F;
            text-decoration: none;
            font-size: 0.95em;
            transition: all 0.2s;
        }

        .back-link a:hover {
            color: #1F4560;
        }

        @media (max-width: 768px) {
            body {
                padding: 30px 20px;
            }

            .container {
                padding: 40px 30px;
            }

            h1 {
                font-size: 1.8em;
                margin-bottom: 28px;
            }

            .form-group {
                margin-bottom: 20px;
            }

            label {
                font-size: 0.95em;
            }

            input[type="password"] {
                padding: 12px;
                font-size: 0.95em;
            }

            button {
                padding: 12px;
                font-size: 0.95em;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 20px;
            }

            .container {
                padding: 30px 20px;
            }

            h1 {
                font-size: 1.5em;
                margin-bottom: 24px;
            }

            .form-group {
                margin-bottom: 18px;
            }

            label {
                margin-bottom: 8px;
                font-size: 0.9em;
            }

            input[type="password"] {
                padding: 12px;
                font-size: 1em;
            }

            .error {
                padding: 12px;
                margin-bottom: 18px;
                font-size: 0.9em;
            }

            button {
                padding: 12px;
                font-size: 0.95em;
            }

            .back-link {
                margin-top: 20px;
            }

            .back-link a {
                font-size: 0.9em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1><% if (round) { %>Unlock Round <%= round %> Results<% } else { %>Unlock Results<% } %></h1>

        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form method="POST" action="/login">
            <input type="hidden" name="round" value="<%= round || 1 %>">
            <div class="form-group">
                <label for="password">Enter Password</label>
                <input type="password" id="password" name="password" required autofocus>
            </div>
            <button type="submit">Sign In</button>
        </form>

        <div class="back-link">
            <a href="/">← Back to Home</a>
        </div>
    </div>
</body>
</html>
