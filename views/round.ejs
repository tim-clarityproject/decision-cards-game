<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Round <%= roundNumber %> - Leadership Simulation</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background: #FAFAFA;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 60px;
        }

        .breadcrumb {
            color: #666;
            font-size: 0.95em;
            margin-bottom: 20px;
            font-weight: 400;
        }

        .breadcrumb a {
            color: #1A1A1A;
            text-decoration: none;
            font-weight: 600;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        h1 {
            color: #1A1A1A;
            margin-bottom: 12px;
            font-size: 3.5em;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.5px;
        }

        .subtitle {
            color: #666;
            font-size: 1.2em;
            font-weight: 400;
            margin-bottom: 20px;
        }

        .container {
            max-width: 700px;
            width: 100%;
        }

        .card-links {
            display: flex;
            gap: 24px;
            flex-direction: column;
            margin-bottom: 50px;
        }

        .card-link {
            display: block;
            padding: 24px 32px;
            background: #1A1A1A;
            color: white;
            text-decoration: none;
            border-radius: 0;
            font-size: 1.1em;
            font-weight: 600;
            transition: all 0.3s;
            box-shadow: none;
            border: none;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-link:hover {
            transform: none;
            background: #333;
        }

        .back-link {
            text-align: center;
            margin-top: 40px;
        }

        .back-link a {
            color: #1A1A1A;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s;
        }

        .back-link a:hover {
            color: #333;
        }

        @media (max-width: 768px) {
            body {
                padding: 30px 20px;
            }

            .header {
                margin-bottom: 40px;
            }

            h1 {
                font-size: 2.5em;
                margin-bottom: 10px;
            }

            .subtitle {
                font-size: 1.1em;
            }

            .card-links {
                gap: 18px;
                margin-bottom: 40px;
            }

            .card-link {
                padding: 24px;
                font-size: 1.1em;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 20px;
            }

            .header {
                margin-bottom: 30px;
            }

            h1 {
                font-size: 1.8em;
                margin-bottom: 8px;
            }

            .subtitle {
                font-size: 0.95em;
            }

            .card-links {
                gap: 12px;
                margin-bottom: 30px;
            }

            .card-link {
                padding: 20px;
                font-size: 1em;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="breadcrumb">
            <a href="/">Home</a> / Round <%= roundNumber %>
        </div>
        <h1>Round <%= roundNumber %></h1>
        <p class="subtitle">Leadership Simulation</p>
    </div>

    <div class="container">
        <div class="card-links">
            <a href="/round/<%= roundNumber %>/team-actions" class="card-link">Team Actions for Round <%= roundNumber %></a>
            <a href="/round/<%= roundNumber %>/stakeholder-actions" class="card-link">Stakeholder Actions for Round <%= roundNumber %></a>
        </div>

        <div style="background: white; border: 1px solid #E8E8E8; border-radius: 0; padding: 30px; margin-top: 40px; text-align: center; box-shadow: none;">
            <% if (authenticatedRounds && authenticatedRounds.includes(roundNumber)) { %>
                <p style="color: #1A1A1A; font-size: 1em; margin: 0; font-weight: 600;">Results Unlocked</p>
            <% } else { %>
                <h3 style="color: #1A1A1A; font-size: 1.2em; margin-bottom: 20px; font-weight: 600;">Unlock Results</h3>
                <form method="POST" action="/login" style="max-width: 300px; margin: 0 auto;">
                    <% if (error) { %>
                        <div style="background: #FDE8E8; border: 1px solid #F0C4C4; color: #C44545; padding: 12px; border-radius: 0; margin-bottom: 16px; font-size: 0.95em;">
                            <%= error %>
                        </div>
                    <% } %>
                    <input type="hidden" name="round" value="<%= roundNumber %>">
                    <input type="password" name="password" placeholder="Enter password" required style="width: 100%; padding: 12px; border: 1px solid #D8D8D8; border-radius: 0; font-size: 1em; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; margin-bottom: 12px; background: #FAFAFA;">
                    <button type="submit" style="width: 100%; padding: 14px; background: #1A1A1A; color: white; border: none; border-radius: 0; font-size: 0.95em; cursor: pointer; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 600; transition: all 0.3s; text-transform: uppercase; letter-spacing: 0.5px;" onmouseover="this.style.background='#333';" onmouseout="this.style.background='#1A1A1A';">Unlock Results</button>
                </form>
            <% } %>
        </div>
    </div>

    <div class="back-link">
        <a href="/">← Select a Round</a>
    </div>
</body>
</html>
